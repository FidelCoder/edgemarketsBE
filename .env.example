PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,https://polymarket.com,https://*.polymarket.com,chrome-extension://*
NETWORK_MODE=mainnet
POLYGON_NETWORK=polygon
POLYMARKET_ENVIRONMENT=production
